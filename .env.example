# Qoder CN Personal Access Token (required)
# Fill this with your own token. Never commit the real .env file.
QODER_PAT=

# Listen address: 127.0.0.1 for local only, 0.0.0.0 for LAN access.
HOST=0.0.0.0

# HTTP port.
PORT=8788

# API key for OpenAI / Anthropic clients.
# Leave empty to auto-generate on first start (the generated key is written back to .env).
PROXY_API_KEY=

# Web UI auto-auth mode: private | local | off
# private: loopback + private LAN clients get the key auto-filled
# local:   only this machine
# off:     always ask for the key manually
UI_AUTO_AUTH=private

# Qoder CN application path (optional).
# QODER_APP_PATH=/Applications/Qoder CN.app
