# Optional: Qoder CN Personal Access Token (legacy single-account mode).
# Leave empty if you use OAuth accounts via ./accounts.sh.
# Never commit the real .env file.
QODER_PAT=

# Listen address: 127.0.0.1 for local only, 0.0.0.0 for LAN access.
HOST=0.0.0.0

# HTTP port.
PORT=8788

# API key for OpenAI / Anthropic clients.
# Leave empty to auto-generate on first start (the generated key is written back to .env).
PROXY_API_KEY=

# Web UI auto-auth mode: private | local | off
# private: loopback + private LAN clients get the key auto-filled
# local:   only this machine
# off:     always ask for the key manually
UI_AUTO_AUTH=private

# Qoder CN application path (optional).
# QODER_APP_PATH=/Applications/Qoder CN.app

# Account pool home (optional; default ~/.qoder-cn-pool).
# QODER_POOL_HOME=

# Path to the official Qoder CN CLI for OAuth login/health checks (optional).
# If unset, accounts.sh looks for qoderclicn/qodercn, then falls back to npx.
# QODER_CLI_BIN=

# Account health-check interval in milliseconds (default: 600000 = 10 minutes).
# ACCOUNT_HEALTH_INTERVAL_MS=600000
